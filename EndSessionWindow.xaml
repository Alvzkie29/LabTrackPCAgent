<Window x:Class="LabTrackAgent.EndSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabTrack"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#1E1E2E"
        SizeChanged="Window_SizeChanged">

    <Border BorderBrush="#3A3A4C" BorderThickness="1">
        <Grid>

            <!-- The full bar: who is logged in, and the End Session button -->
            <StackPanel x:Name="FullBar" Orientation="Horizontal" Margin="12,6">
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="NameText" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="InfoText" Foreground="#AAAAAA" FontSize="11"/>
                </StackPanel>
                <Button x:Name="HideButton" Content="Hide" Padding="10,4" FontSize="12"
                        VerticalAlignment="Center" Margin="0,0,8,0" Click="HideButton_Click"/>
                <Button x:Name="EndButton" Content="End Session" Padding="12,4" FontSize="12"
                        FontWeight="SemiBold" VerticalAlignment="Center" Click="EndButton_Click"/>
            </StackPanel>

            <!-- The small tab shown while the bar is hidden. Clicking it brings the bar back. -->
            <Button x:Name="ShowButton" Content="LabTrack" Visibility="Collapsed"
                    Padding="10,1" FontSize="10" Click="ShowButton_Click"/>
        </Grid>
    </Border>
</Window>
