<Window x:Class="LabTrackAgent.EndSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabTrack session" Width="430" SizeToContent="Height" Icon="Assets/labtrack.ico"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="SessionButton" TargetType="Button">
            <Setter Property="Background" Value="#F8F2ED"/>
            <Setter Property="Foreground" Value="#800000"/>
            <Setter Property="BorderBrush" Value="#E8D8D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEE2D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5D4C7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#800000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SessionIconButton" TargetType="Button" BasedOn="{StaticResource SessionButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Border Margin="5" Background="#FDFBF9" BorderBrush="#E4D7CF"
            BorderThickness="1" CornerRadius="10" MouseLeftButtonDown="SessionBar_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#30201B" BlurRadius="8" ShadowDepth="1" Opacity="0.14"/>
        </Border.Effect>

        <Grid>
            <Grid x:Name="ExpandedPanel" Margin="9,5" ToolTip="Drag to move the session bar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Source="Assets/labtrack.png" Width="28" Height="28" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                    <TextBlock x:Name="NameText" Foreground="#30292A" FontWeight="SemiBold"
                               FontSize="11" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="InfoText" Foreground="#75665E" FontSize="10" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>

                <Button Grid.Column="2" Content="End Session" Style="{StaticResource SessionButton}"
                        VerticalAlignment="Center" Click="EndButton_Click"/>

                <Button x:Name="HideSessionButton" Grid.Column="3" Margin="4,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource SessionIconButton}"
                        ToolTip="Collapse session details" AutomationProperties.Name="Collapse session details"
                        Click="HideSessionButton_Click">
                    <Path Data="M 0,5 L 5,0 L 10,5" Stroke="#75665E" StrokeThickness="1.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource SessionIconButton}" VerticalAlignment="Center"
                        ToolTip="Hide to notification area (session stays active)"
                        AutomationProperties.Name="Hide session bar to notification area" Click="HideToTrayButton_Click">
                    <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="#75665E" StrokeThickness="1.3"/>
                </Button>
            </Grid>

            <Grid x:Name="CompactPanel" Visibility="Collapsed" Height="22" Margin="7,3"
                  ToolTip="Drag to move the session tab">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/labtrack.png" Width="18" Height="18"/>
                <TextBlock Grid.Column="1" Text="Session" FontSize="11" Foreground="#800000"
                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                <Button x:Name="ShowSessionButton" Grid.Column="2" Style="{StaticResource SessionIconButton}"
                        Height="22" ToolTip="Show session details" AutomationProperties.Name="Show session details"
                        Click="ShowSessionButton_Click">
                    <Path Data="M 0,0 L 5,5 L 10,0" Stroke="#800000" StrokeThickness="1.3"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource SessionIconButton}" Height="22"
                        ToolTip="Hide to notification area (session stays active)"
                        AutomationProperties.Name="Hide session bar to notification area" Click="HideToTrayButton_Click">
                    <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="#75665E" StrokeThickness="1.3"/>
                </Button>
            </Grid>

            <!-- A small vertical dock when dragged to either side of the display. -->
            <StackPanel x:Name="VerticalPanel" Visibility="Collapsed" Margin="5,8"
                        ToolTip="Drag the logo away from the edge to restore the session bar">
                <Image Source="Assets/labtrack.png" Width="26" Height="26" Cursor="SizeAll"/>
                <Border Height="1" Width="18" Background="#E6DAD2" Margin="0,7,0,6"/>
                <Button x:Name="DockedEndSessionButton" Style="{StaticResource SessionIconButton}" Width="28" Height="28" Padding="5"
                        ToolTip="End Session and lock this computer" AutomationProperties.Name="End Session and lock this computer"
                        Click="EndButton_Click">
                    <Path Data="M 12,2 L 12,12 M 18.4,5.6 A 9,9 0 1 1 5.6,5.6"
                          Width="16" Height="16" Stretch="Uniform" Stroke="#800000" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Button Style="{StaticResource SessionIconButton}" Width="26" Height="22" Margin="0,3,0,0"
                        ToolTip="Hide to notification area (session stays active)"
                        AutomationProperties.Name="Hide session bar to notification area" Click="HideToTrayButton_Click">
                    <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="#75665E" StrokeThickness="1.3"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
