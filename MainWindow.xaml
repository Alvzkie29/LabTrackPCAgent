<Window x:Class="LabTrackAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabTrack" Height="560" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E2E">

    <!-- Phase 1: a normal window. The full-screen lock comes in a later phase. -->

    <Grid Margin="32">

        <!-- Screen 1: login -->
        <StackPanel x:Name="LoginPanel" VerticalAlignment="Center" MaxWidth="336" HorizontalAlignment="Center">

            <TextBlock Text="LabTrack" FontSize="28" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Log in to use this computer" FontSize="13"
                       Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <TextBlock Text="Student ID" Foreground="#CCCCCC" FontSize="12" Margin="2,0,0,4"/>
            <TextBox x:Name="StudentIdBox" Height="36" Padding="8,6" FontSize="14" Margin="0,0,0,16"/>

            <TextBlock Text="Password" Foreground="#CCCCCC" FontSize="12" Margin="2,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="36" Padding="8,6" FontSize="14" Margin="0,0,0,8"/>

            <TextBlock x:Name="StatusText" Foreground="#FF6B6B" FontSize="12"
                       TextWrapping="Wrap" Margin="2,4,2,12" MinHeight="16"/>

            <Button x:Name="LoginButton" Content="Log In" Height="40" FontSize="14"
                    FontWeight="SemiBold" Click="LoginButton_Click"/>
        </StackPanel>

        <!-- Screen 2: confirm the class -->
        <StackPanel x:Name="ConfirmPanel" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="336" HorizontalAlignment="Center">

            <TextBlock x:Name="WelcomeText" FontSize="20" FontWeight="Bold" Foreground="White"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock x:Name="PromptText" FontSize="13" Foreground="#AAAAAA"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Border Background="#2A2A3C" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                <TextBlock x:Name="SuggestedText" Foreground="White" FontSize="15"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <Button x:Name="YesButton" Content="Yes, record my attendance" Height="40" FontSize="14"
                    FontWeight="SemiBold" Click="YesButton_Click" Margin="0,0,0,8"/>
            <Button x:Name="ChooseOtherButton" Content="No, choose another class" Height="36" FontSize="13"
                    Click="ChooseOtherButton_Click" Margin="0,0,0,8"/>

            <ComboBox x:Name="OtherClassesBox" Height="36" FontSize="13"
                      Visibility="Collapsed" Margin="0,0,0,8"/>
            <Button x:Name="RecordSelectedButton" Content="Record my attendance" Height="40" FontSize="14"
                    FontWeight="SemiBold" Visibility="Collapsed" Click="RecordSelectedButton_Click"
                    Margin="0,0,0,8"/>

            <TextBlock x:Name="ConfirmStatusText" Foreground="#FF6B6B" FontSize="12"
                       TextWrapping="Wrap" Margin="2,4,2,8" MinHeight="16"/>

            <Button x:Name="CancelButton" Content="Cancel" Height="32" FontSize="12"
                    Click="CancelButton_Click"/>
        </StackPanel>

    </Grid>
</Window>